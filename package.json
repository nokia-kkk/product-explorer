{
  "name": "miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=packages/server\" \"npm run dev --workspace=packages/client\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "import": "npm run import --workspace=packages/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
